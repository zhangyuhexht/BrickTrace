{
	"schemaVersion": 1,
	"id": "bricktrace",
	"version": "${version}",
	"name": "BrickTrace",
	"description": "Hardware ray tracing for Minecraft 26.3: static brick BVH with dynamic voxel payload.",
	"authors": [
		"BrickTrace contributors"
	],
	"contact": {
		"homepage": "https://github.com/zhangyuhexht/BrickTrace",
		"sources": "https://github.com/zhangyuhexht/BrickTrace"
	},
	"license": "GPL-3.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.bricktrace.BrickTraceMod"
		],
		"client": [
			"dev.bricktrace.client.BrickTraceClient"
		]
	},
	"mixins": [
		"bricktrace.mixins.json",
		{
			"config": "bricktrace.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
