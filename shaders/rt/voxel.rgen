#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 5, rgba8) uniform image2D outImage;

layout(binding = 6) uniform Params {
    vec4 camPos;
    vec4 camForward;
    vec4 camRight;
    vec4 camUp;
    vec4 sunDir;
    vec4 misc;  // width, height, tanHalfFov, frame
} params;

struct HitPayload {
    vec3 color;
    vec3 normal;
    float t;
    int material;
    int hit;
};

layout(location = 0) rayPayloadEXT HitPayload primary;
layout(location = 1) rayPayloadEXT float shadowLit;

vec3 skyColor(vec3 dir) {
    float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 horizon = vec3(0.62, 0.74, 0.92);
    vec3 zenith = vec3(0.18, 0.36, 0.72);
    vec3 color = mix(horizon, zenith, t);
    float sun = max(dot(dir, normalize(params.sunDir.xyz)), 0.0);
    return color + vec3(1.0, 0.92, 0.75) * pow(sun, 256.0) * 4.0;
}

void main() {
    const vec2 resolution = params.misc.xy;
    const vec2 uv = (vec2(gl_LaunchIDEXT.xy) + 0.5) / resolution * 2.0 - 1.0;
    const float aspect = resolution.x / resolution.y;

    const vec3 dir = normalize(params.camForward.xyz +
                               params.camRight.xyz * (uv.x * params.misc.z * aspect) +
                               params.camUp.xyz * (uv.y * params.misc.z));

    primary.hit = 0;
    primary.t = 1e30;
    primary.color = vec3(0.0);
    primary.normal = vec3(0.0);
    primary.material = 0;

    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                params.camPos.xyz, 0.02, dir, 8000.0, 0);

    vec3 color;
    if (primary.hit != 0) {
        const vec3 origin = params.camPos.xyz + dir * primary.t;
        shadowLit = 1.0;
        traceRayEXT(topLevelAS,
                    gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                    0xff, 0, 1, 1,
                    origin + primary.normal * 0.15, 0.02, normalize(params.sunDir.xyz), 4000.0, 1);

        const float ndl = max(dot(primary.normal, normalize(params.sunDir.xyz)), 0.0);
        const float sky = primary.normal.y * 0.5 + 0.5;
        const float ambient = 0.18 + 0.35 * sky;
        const float direct = shadowLit * ndl * 0.9;
        color = primary.color * (ambient + direct) + vec3(0.02, 0.03, 0.05) * sky;
    } else {
        color = skyColor(dir);
    }

    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(color, 1.0));
}
